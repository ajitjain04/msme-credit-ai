# Copy this file to .env and set your own PostgreSQL password.
# .env is git-ignored (never committed); this .env.example file IS committed,
# so anyone cloning the repo knows which variable to set without seeing
# anyone's real password.
#
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
# The "+psycopg2" is deliberate, not optional: a bare "postgresql://" lets
# SQLAlchemy pick whichever Postgres driver it finds, and on newer
# SQLAlchemy versions that can resolve to "psycopg" (v3) instead of
# "psycopg2" (what requirements.txt actually installs) -- causing a
# ModuleNotFoundError even though a perfectly good driver IS installed.
# Being explicit avoids that ambiguity entirely.
# If DATABASE_URL is left unset entirely (e.g. .env doesn't exist yet),
# backend/database.py falls back to the original SQLite file at
# data/processed/msme_credit.db instead of failing -- see that file's
# module docstring.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD_HERE@localhost:5432/msme_credit
