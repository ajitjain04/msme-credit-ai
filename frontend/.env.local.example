# Copy this file to .env.local (git-ignored) before running the dev server.
#
# NEXT_PUBLIC_ prefix is REQUIRED for any environment variable that needs
# to be readable in the BROWSER (client-side React code), not just on the
# server -- Next.js inlines NEXT_PUBLIC_* variables into the JavaScript
# bundle at build time. See .env.local's own comment for the full
# explanation.
#
# This is the URL the FastAPI backend (backend/main.py) is running at --
# http://localhost:8000 when started locally with:
#   venv\Scripts\python.exe -m uvicorn backend.main:app --reload
NEXT_PUBLIC_API_URL=http://localhost:8000
