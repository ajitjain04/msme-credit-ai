# Copy this file to .env.local (git-ignored) before running the dev server.
#
# VITE_API_URL is read by src/api.ts via import.meta.env.VITE_API_URL --
# Vite only exposes environment variables prefixed with VITE_ to client
# code, and inlines them into the browser bundle at build time.
#
# This is the URL the FastAPI backend (backend/main.py) runs at locally:
#   venv\Scripts\python.exe -m uvicorn backend.main:app --reload
VITE_API_URL=http://localhost:8000
